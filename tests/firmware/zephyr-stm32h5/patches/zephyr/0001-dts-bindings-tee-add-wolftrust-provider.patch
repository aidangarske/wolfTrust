From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: wolfTrust <noreply@wolfssl.com>
Date: Tue, 26 May 2026 00:00:00 +0000
Subject: [PATCH 1/3] dts: bindings: add wolfTrust TEE provider binding

Also registers the "wolfssl" vendor prefix used by the compatible.

---
 dts/bindings/tee/wolfssl,wolftrust-tee.yaml | 32 +++++++++++++++++++++
 dts/bindings/vendor-prefixes.txt            |  1 +
 2 files changed, 33 insertions(+)
 create mode 100644 dts/bindings/tee/wolfssl,wolftrust-tee.yaml

diff --git a/dts/bindings/tee/wolfssl,wolftrust-tee.yaml b/dts/bindings/tee/wolfssl,wolftrust-tee.yaml
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/dts/bindings/tee/wolfssl,wolftrust-tee.yaml
@@ -0,0 +1,30 @@
+# Copyright (c) 2026 wolfSSL Inc.
+# SPDX-License-Identifier: Apache-2.0
+
+description: wolfTrust non-secure TEE provider
+
+compatible: "wolfssl,wolftrust-tee"
+
+include: base.yaml
+
+properties:
+  label:
+    type: string
+    description: Human readable instance label
+  shared-uart:
+    type: int
+    required: false
+    description: Shared USART instance used by secure and non-secure guests
+  wolftrust-guest-slot:
+    type: int
+    required: true
+    enum:
+      - 0
+      - 1
+    description: wolfTrust guest slot routed to this non-secure image
+  cmse-transport-offset:
+    type: int
+    required: false
+    default: 0x100
+    description: Offset in guest RAM reserved for the CMSE transport window
+
diff --git a/dts/bindings/vendor-prefixes.txt b/dts/bindings/vendor-prefixes.txt
index 1111111111aa..1111111111bb 100644
--- a/dts/bindings/vendor-prefixes.txt
+++ b/dts/bindings/vendor-prefixes.txt
@@ -759,6 +759,7 @@
 wnc	Wistron NeWeb Corporation
 wobo	Wobo
 wolfson	Cirrus Logic, Inc. (formerly Wolfson Microelectronics plc)
+wolfssl	wolfSSL Inc.
 worldsemi	Worldsemi Co., Limited
 wurth	Wurth Elektronik
 x-powers	X-Powers
--
2.39.5
